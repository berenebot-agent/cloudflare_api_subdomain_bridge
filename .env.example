# Copy to .env; do not commit real keys.

# Create at: Dashboard > Manage Account > Account API Tokens > Create Token
# Required token permissions:
#   Zone    | DNS                    | Edit
#   Zone    | Zone                   | Read
#   Zone    | Workers Routes         | Edit
#   Zone    | Email Routing Rules    | Edit
#   Account | Cloudflare Tunnel      | Edit
#   Account | Workers Scripts        | Edit
CF_API_TOKEN=replace_with_account_scoped_cloudflare_api_token

# From Dashboard > Domains > your domain > API section (right sidebar)
CF_ACCOUNT_ID=replace_with_cloudflare_account_id
CF_ZONE_ID=replace_with_cloudflare_zone_id
CF_ZONE_NAME=example.com

# Listener bind address and port (compose publishes this port).
BRIDGE_LISTEN_ADDR=0.0.0.0
BRIDGE_PORT=4403
# Container name used by docker compose.
BRIDGE_CONTAINER_NAME=cloudflare-bridge
BRIDGE_DATA_DIR=/data
BRIDGE_RATE_PER_MIN=120

# Client keys. Generate with: openssl rand -hex 32
# permissions: subset of dns, workers, tunnels, email
BRIDGE_CLIENT_HERMES='{"key":"REPLACE_WITH_A_LONG_RANDOM_CLIENT_KEY","scope":"hermes.example.com","descendants":true,"permissions":["dns","workers","tunnels","email"]}'
BRIDGE_CLIENT_MAIL='{"key":"REPLACE_WITH_ANOTHER_RANDOM_KEY_HERE","scope":"mail.example.com","descendants":true,"permissions":["dns","email"]}'
